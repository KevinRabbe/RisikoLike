[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/presentation/main_menu.gd" id="1"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Menu" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Center/Menu"]
layout_mode = 2
text = "RisikoLike"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 48

[node name="Spacer" type="Control" parent="Center/Menu"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2

[node name="CreateLobby" type="Button" parent="Center/Menu"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
text = "Lobby erstellen"

[node name="JoinLobby" type="Button" parent="Center/Menu"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
text = "Lobby beitreten"

[node name="Settings" type="Button" parent="Center/Menu"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
text = "Einstellungen"

[node name="Exit" type="Button" parent="Center/Menu"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
text = "Beenden"

[node name="VersionLabel" type="Label" parent="Center/Menu"]
unique_name_in_owner = true
layout_mode = 2
text = "v0.1.0-dev"
horizontal_alignment = 1

[connection signal="pressed" from="Center/Menu/CreateLobby" to="." method="_on_create_lobby_pressed"]
[connection signal="pressed" from="Center/Menu/JoinLobby" to="." method="_on_join_lobby_pressed"]
[connection signal="pressed" from="Center/Menu/Settings" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="Center/Menu/Exit" to="." method="_on_exit_pressed"]
